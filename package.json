{
  "name": "globalofficefinder",
  "private": true,
  "version": "0.0.0",
  "ciRerunTrigger": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate-data": "node scripts/validate-data.mjs",
    "validate-data-fast": "node scripts/validate-data-fast.mjs",
    "discover:companies": "node scripts/discover-top-companies.mjs",
    "enrich:photos": "node scripts/enrich-company-photos.mjs",
    "enrich:photos:dry": "node scripts/enrich-company-photos.mjs --dry-run",
    "discover:companies:dry": "DISCOVER_DRY_RUN=1 node scripts/discover-top-companies.mjs",
    "scrape:companies": "node scripts/scraper/run-scraper.mjs",
    "scrape:companies:dry": "SCRAPER_DRY_RUN=1 node scripts/scraper/run-scraper.mjs",
    "scrape:discover": "node scripts/discover-top-companies.mjs && node scripts/scraper/run-scraper.mjs",
    "verify:offices": "node scripts/scraper/verify-offices.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"data/**/*.json\"",
    "test": "vitest",
    "test:ci:unit": "vitest run --reporter dot",
    "test:ci:e2e": "playwright test",
    "test:ci": "npm ci --silent && npm run test:ci:unit && npm run test:ci:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "ci:gate": "node scripts/ci/scraper-ci-gate.mjs",
    "ci:perf": "node scripts/ci/scraper-perf-gate.mjs"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.13.2",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.4"
  }
}
